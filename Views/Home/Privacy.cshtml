@{
    ViewData["Title"] = "За нас";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4">
                <h1 class="display-5 fw-bold text-primary mb-4">ℹ️ За проекта DogBreedsApp</h1>

                <p class="lead text-secondary mb-4">
                    Този уебсайт е създаден с една основна цел – <strong>да улесни избора на вашия бъдещ породен домашен любимец</strong>. Изборът на куче е важна стъпка и правилното съответствие между вашия начин на живот и нуждите на породата е от решаващо значение за щастието и на двете страни.
                </p>

                <hr class="my-4" />

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border-start border-4 border-primary">
                            <h5 class="fw-bold">🎯 Нашата мисия</h5>
                            <p class="text-muted mb-0">
                                Да предоставим бърза, синтезирана и полезна информация за характеристиките, нивото на енергия и изискванията за грижа на различни породи кучета.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border-start border-4 border-success">
                            <h5 class="fw-bold">➕ Постоянно обновяване</h5>
                            <p class="text-muted mb-0">
                                В момента в базата данни са включени само част от съществуващите породи по света. Затова сме добавили възможност всеки потребител лесно да добавя нови породи в каталога!
                            </p>
                        </div>
                    </div>
                </div>

                <div class="bg-primary bg-opacity-10 p-4 rounded-3 text-dark mt-2">
                    <h5 class="fw-bold mb-2">👤 За създателя</h5>
                    <p class="mb-0">
                        Проектът е разработен като практическа задача по ASP.NET Core MVC (Модул 1) за изграждане на съвременна, динамична и лесна за използване уеб платформа.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
