@model DogBreedsApp.ViewModels.DogBreedDetailsViewModel

@{
    ViewData["Title"] = "Потвърждение за изтриване";
}

<div class="alert alert-danger shadow-sm my-4">
    <h4 class="alert-heading fw-bold">⚠️ Внимание!</h4>
    <p class="mb-0">Сигурни ли сте, че искате да изтриете породата <strong>@Model.Name</strong>? Това действие е необратимо.</p>
</div>

<div class="card p-4 shadow-sm mb-4 col-md-8">
    <div class="d-flex align-items-center gap-3">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded" style="width: 100px; height: 100px; object-fit: cover;">
        <div>
            <h5 class="fw-bold mb-1">@Model.Name</h5>
            <p class="text-muted mb-0">@Model.ShortDescription</p>
        </div>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger btn-lg">Да, изтрий</button>
    <a asp-action="Index" class="btn btn-secondary btn-lg">Отказ</a>
</form>
