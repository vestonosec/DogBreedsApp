@model IEnumerable<DogBreedsApp.ViewModels.DogBreedFormViewModel>

@{
    ViewData["Title"] = "Породи кучета";
    var breedGroups = ViewBag.BreedGroups as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6 fw-bold">🐾 Каталог Породи Кучета</h1>
    <a asp-action="Create" class="btn btn-primary btn-lg">+ Добави нова порода</a>
</div>

<!-- Форма за търсене и филтриране -->
<form method="get" asp-action="Index" class="card p-3 shadow-sm mb-4 bg-light">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Търси по име или описание..." />
        </div>
        <div class="col-md-4">
            <select name="breedGroupId" class="form-select">
                <option value="">-- Всички групи --</option>
                @foreach (var group in breedGroups)
                {
                    if (ViewBag.CurrentGroup?.ToString() == group.Value)
                    {
                        <option value="@group.Value" selected="selected">@group.Text</option>
                    }
                    else
                    {
                        <option value="@group.Value">@group.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary w-100">Търси</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Изчисти</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info text-center my-4">
        Няма намерени породи, отговарящи на зададените критерии.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 220px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-muted flex-grow-1">@item.ShortDescription</p>
                        <ul class="list-group list-group-flush mb-3 small">
                            <li class="list-group-item bg-transparent px-0">📍 <strong>Произход:</strong> @item.Origin</li>
                            <li class="list-group-item bg-transparent px-0">⏳ <strong>Живот:</strong> ~@item.AverageLifespanYears г.</li>
                            <li class="list-group-item bg-transparent px-0">⚡ <strong>Енергия:</strong> @item.EnergyLevel / 5</li>
                        </ul>
                        <div class="d-flex justify-content-between gap-1 mt-auto">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm w-100">Детайли</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm w-100">Редакция</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm w-100">Изтрий</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
